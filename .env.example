# ──────────────────────────────────────────────────────────────
# .env.example — Variables de entorno de referencia
# INSTRUCCIONES:
#   cp .env.example .env
#   Editar .env con valores reales (nunca commitear .env)
# ──────────────────────────────────────────────────────────────

# Base de datos (valores de desarrollo; deben coincidir con los del volumen ya creado)
DB_USER=postgrado_user
DB_PASSWORD=postgrado_dev_password
DB_NAME=postgrado_dev
# Usada al correr uvicorn fuera de Docker. Dentro de Docker, docker-compose la reemplaza (host "db").
DATABASE_URL=postgresql+asyncpg://postgrado_user:postgrado_dev_password@localhost:5432/postgrado_dev

# JWT
# Generar uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar_en_produccion_por_secreto_seguro_de_minimo_32_caracteres
JWT_EXPIRACION_MINUTOS=480

# Storage de archivos
STORAGE_PATH=./storage          # Dentro de Docker se usa /var/postgrado-storage
MAX_FILE_SIZE_MB=5

# Email
EMAIL_MODO=smtp            # smtp (envía a MailHog / servidor real) | simulado (solo log)
SMTP_HOST=localhost        # Dentro de Docker: mailhog. En prod: smtp.utn.edu.ar
SMTP_PORT=1025             # MailHog usa 1025. SMTP real usa 587
SMTP_USER=                 # Solo para producción
SMTP_PASSWORD=             # Solo para producción
EMAIL_FROM=noreply@posgrado.frlp.utn.edu.ar
EMAIL_COORDINACION=coordinacion@posgrado.frlp.utn.edu.ar   # Recibe los avisos de reservas vencidas

# Frontend (Expo web corre en el puerto 8081)
FRONTEND_URL=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Configuración
PORT=8000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006   # Separados por coma